# Proofig PDF Service Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed to the repo

# Google Cloud Configuration (for build + deploy)
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1

# Cloud Run sizing (optional; defaults shown)
# Chromium can be memory hungry — bump to 4G if you see OOMs.
MEMORY=2G
CPU=2

# Local Development Port
PORT=8080

# Render-only smoke tests (POST /test-render — no SCMS job/upload/hooks)
# PROOFIG_PDF_RENDER_ONLY=1
# Host directory mounted into the container; PDF written as proofig-report.pdf
# RENDER_OUTPUT_DIR=./output
