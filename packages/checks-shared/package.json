{
  "name": "@hhmi/checks-shared",
  "private": true,
  "version": "0.1.0",
  "description": "Shared authorization helpers for HHMI check extensions",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "browser": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analytics/events": {
      "development": "./src/analytics/events.ts",
      "types": "./dist/analytics/events.d.ts",
      "default": "./dist/analytics/events.js"
    },
    "./analytics/client": {
      "development": "./src/analytics/client.ts",
      "types": "./dist/analytics/client.d.ts",
      "default": "./dist/analytics/client.js"
    },
    "./analytics/server": {
      "development": "./src/analytics/server.ts",
      "types": "./dist/analytics/server.d.ts",
      "default": "./dist/analytics/server.js"
    },
    "./analytics/properties": {
      "development": "./src/analytics/properties.ts",
      "types": "./dist/analytics/properties.d.ts",
      "default": "./dist/analytics/properties.js"
    },
    "./analytics/runContext.server": {
      "development": "./src/analytics/runContext.server.ts",
      "types": "./dist/analytics/runContext.server.d.ts",
      "default": "./dist/analytics/runContext.server.js"
    },
    "./analytics/trigger.server": {
      "development": "./src/analytics/trigger.server.ts",
      "types": "./dist/analytics/trigger.server.d.ts",
      "default": "./dist/analytics/trigger.server.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "npx eslint -c ../../.eslintrc.cjs \"src/**/*.ts\"",
    "lint:format": "prettier --check \"src/**/*.ts\"",
    "lint:format:fix": "prettier --write \"src/**/*.ts\"",
    "build": "tsc --project tsconfig.json",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@curvenote/scms-core": "*",
    "@curvenote/scms-server": "*",
    "react": "^18.3.1",
    "react-router": "^7.9.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint-config-curvenote": "^0.0.4",
    "prettier": "^3.5.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.21.0"
  }
}
